# ELARA - Git Ignore File
# This file specifies intentionally untracked files that Git should ignore

# ============================================
# Environment & Configuration
# ============================================
.env
.env.local
.env.*.local
config.local.json

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

