# ELARA - Environment Configuration Example
# Copy this file to .env and fill in your actual values
# Never commit the .env file with real secrets to version control

# ============================================
# AI PROVIDER CONFIGURATION
# ============================================
# Choose your AI provider: openai, anthropic, or local
AI_PROVIDER=openai

# API key for your chosen AI provider
# Get your API key from the provider's dashboard
AI_API_KEY=your_api_key_here

# AI model to use
# Examples: gpt-4, gpt-3.5-turbo, claude-3-opus, etc.
AI_MODEL=gpt-4

# Optional: Custom base URL for AI API
# AI_BASE_URL=https://api.example.com/v1

# AI parameters
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# ============================================
# WAKE WORD CONFIGURATION
# ============================================
# The wake word to activate ELARA
ELARA_WAKE_WORD=Hey Elara

# Wake word detection sensitivity (0.0 - 1.0)
ELARA_WAKE_WORD_SENSITIVITY=0.5

# Timeout for wake word detection in seconds
ELARA_WAKE_WORD_TIMEOUT=5.0

# ============================================
# VOICE RECOGNITION CONFIGURATION
# ============================================
# Voice verification threshold (0.0 - 1.0)
# Higher values require more precise voice match
ELARA_VOICE_THRESHOLD=0.75

# Number of phrases required for voice enrollment
ELARA_ENROLLMENT_PHRASES=3

# Enable voice verification
ELARA_ENABLE_VERIFICATION=true

# ============================================
# SPEECH RECOGNITION CONFIGURATION
# ============================================
# Speech-to-text model size: tiny, base, small, medium, large
ELARA_STT_MODEL=base

# Speech recognition language
ELARA_STT_LANGUAGE=en

# Device for speech recognition: cpu or cuda
ELARA_STT_DEVICE=cpu

# Compute type for speech recognition: int8, int16, float16, float32
ELARA_STT_COMPUTE_TYPE=int8

# ============================================
# TEXT-TO-SPEECH CONFIGURATION
# ============================================
# TTS model to use
ELARA_TTS_MODEL=en_US-lessac-medium

# TTS speaking speed (0.5 - 2.0)
ELARA_TTS_SPEED=1.0

# Enable text-to-speech
ELARA_ENABLE_TTS=true

# ============================================
# AUDIO CONFIGURATION
# ============================================
# Audio sample rate
ELARA_SAMPLE_RATE=16000

# Number of audio channels
ELARA_CHANNELS=1

# Audio chunk size
ELARA_CHUNK_SIZE=1024

# Input device name (leave empty for default)
# ELARA_INPUT_DEVICE=Microphone (Realtek Audio)

# Output device name (leave empty for default)
# ELARA_OUTPUT_DEVICE=Speakers (Realtek Audio)

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Default workspace directory for file operations
ELARA_WORKSPACE=./workspace

# Enable workspace restriction for file operations
ELARA_ENABLE_WORKSPACE_RESTRICTION=true

# Block operations on system paths
ELARA_BLOCK_SYSTEM_PATHS=true

# Require confirmation for sensitive operations
ELARA_REQUIRE_CONFIRMATION_SENSITIVE=true

# Require confirmation for critical operations
ELARA_REQUIRE_CONFIRMATION_CRITICAL=true

# Log all commands for audit purposes
ELARA_LOG_COMMANDS=true

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Database file path
ELARA_DATABASE_PATH=./data/elara.db

# Enable SQL query logging (for debugging)
ELARA_DATABASE_ECHO=false

# ============================================
# LOGGING CONFIGURATION
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
ELARA_LOG_LEVEL=INFO

# Log directory
ELARA_LOG_DIR=./logs

# Maximum log file size in bytes (10 MB default)
ELARA_LOG_MAX_BYTES=10485760

# Number of backup log files to keep
ELARA_LOG_BACKUP_COUNT=5

# ============================================
# UI CONFIGURATION
# ============================================
# UI theme: dark, light
ELARA_THEME=dark

# Start application minimized
ELARA_START_MINIMIZED=false

# Enable UI animations
ELARA_SHOW_ANIMATIONS=true

# Window width
ELARA_WINDOW_WIDTH=1200

# Window height
ELARA_WINDOW_HEIGHT=800

# ============================================
# ADVANCED CONFIGURATION
# ============================================
# Enable debug mode
DEBUG=false

# Development mode (additional logging, relaxed security)
DEV_MODE=false
